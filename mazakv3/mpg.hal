
#custom mpg hal file
#08-8-2026
#andrew beck new zealand
#11-10-2026 rewired to match the "IO list" file

loadrt mux4 count=2
loadrt ilowpass
setp ilowpass.0.scale 100
setp ilowpass.0.gain .05

addf mux4.0      servo-thread
addf mux4.1      servo-thread
addf ilowpass.0  servo-thread


# --- MPG ---
#
# Pendant wiring (see "IO list"), all on the 7i76 field inputs, sserial ch3:
#   input-05  X        input-24  5th (B)
#   input-04  Y        input-25  6th (pallet changer, not an axis yet)
#   input-06  Z        input-26  X10
#   input-07  4th (A)  input-27  X100
# 14-10-2026: 5th/6th/X10/X100 moved from inputs 08-11 to 24-27. Input-08 is
# dead (reads on with nothing connected), so don't use 08 again.
# Handwheel counts: 7i77 MPG counter enc0 (7i77 field inputs 16/17)

# In linux 2.8 need to use joint.x not axis.x or axis.0
# Both joint and axis pins are wired so the MPG works before homing (joint
# mode) and after homing (teleop mode).

setp joint.0.jog-vel-mode 1
setp joint.1.jog-vel-mode 1
setp joint.2.jog-vel-mode 1
setp joint.3.jog-vel-mode 1
setp joint.4.jog-vel-mode 1

setp axis.x.jog-vel-mode 1
setp axis.y.jog-vel-mode 1
setp axis.z.jog-vel-mode 1
setp axis.a.jog-vel-mode 1
setp axis.b.jog-vel-mode 1

# Step size. The selector gives X1 (neither input on), X10 or X100.
#   sel1 sel0
#    0    0   in0  X1
#    0    1   in1  X10
#    1    0   in2  X100
#    1    1   in3  both on (bad switch/wiring) - kept at the X1 size
setp mux4.0.in0 0.00005
setp mux4.0.in1 0.0005
setp mux4.0.in2 0.0025
setp mux4.0.in3 0.00005

net mpg-x10  mux4.0.sel0 mux4.1.sel0 <= hm2_7i92.0.7i76.0.3.input-26
net mpg-x100 mux4.0.sel1 mux4.1.sel1 <= hm2_7i92.0.7i76.0.3.input-27

# A (4th) has its own step sizes on mux4.1, in degrees per count. Since A was
# rescaled to real degrees (14-10-2026) the linear sizes made X100 far too fast.
#   X1 0.005 deg   X10 0.02 deg   X100 0.05 deg   (per raw count, after ilowpass x100)
setp mux4.1.in0 0.00005
setp mux4.1.in1 0.0002
setp mux4.1.in2 0.0005
setp mux4.1.in3 0.00005
net mpg-scale-a <= mux4.1.out

#The output from the mux4 is sent to each axis jog scale
net mpg-scale <= mux4.0.out
net mpg-scale => joint.0.jog-scale => axis.x.jog-scale
net mpg-scale => joint.1.jog-scale => axis.y.jog-scale
net mpg-scale => joint.2.jog-scale => axis.z.jog-scale
net mpg-scale-a => joint.3.jog-scale => axis.a.jog-scale
net mpg-scale => joint.4.jog-scale => axis.b.jog-scale

#Axis select - one input per selector position. Only the selected axis moves.
net mpg-x joint.0.jog-enable <= axis.x.jog-enable <= hm2_7i92.0.7i76.0.3.input-05
net mpg-y joint.1.jog-enable <= axis.y.jog-enable <= hm2_7i92.0.7i76.0.3.input-04
net mpg-z joint.2.jog-enable <= axis.z.jog-enable <= hm2_7i92.0.7i76.0.3.input-06
net mpg-a joint.3.jog-enable <= axis.a.jog-enable <= hm2_7i92.0.7i76.0.3.input-07
# B unhooked 14-10-2026: B has no drive/feedback yet, and input-08 was stuck on,
# so the wheel jogged B too and tripped its following error. Put back when B is live
# (the B selector wire is now on input-24).
#net mpg-b joint.4.jog-enable <= axis.b.jog-enable <= hm2_7i92.0.7i76.0.3.input-24

#Handwheel counts from the 7i77 MPG counter 0
net mpg-out ilowpass.0.in <= hm2_7i92.0.7i77.0.0.enc0.count

#The filtered counts go to every axis. Only the enabled axis will move.
net encoder-counts <= ilowpass.0.out
net encoder-counts => joint.0.jog-counts => axis.x.jog-counts
net encoder-counts => joint.1.jog-counts => axis.y.jog-counts
net encoder-counts => joint.2.jog-counts => axis.z.jog-counts
net encoder-counts => joint.3.jog-counts => axis.a.jog-counts
net encoder-counts => joint.4.jog-counts => axis.b.jog-counts


# --- 6th axis: pallet changer (input-25) ---
# Not live yet. The pallet servo is not a LinuxCNC joint in this config: joints
# 5-7 are the carousel/ATC/shifter extra joints, and extra joints can't be
# jogged once homed. When the pallet servo is added as a real axis (e.g. C on
# joint 5, with [KINS] JOINTS, trivkins coordinates=XYZABC and the extra
# joints renumbered), uncomment and set N to its joint number:
#
#setp joint.N.jog-vel-mode 1
#setp axis.c.jog-vel-mode 1
#net mpg-scale      => joint.N.jog-scale  => axis.c.jog-scale
#net mpg-c joint.N.jog-enable <= axis.c.jog-enable <= hm2_7i92.0.7i76.0.3.input-25
#net encoder-counts => joint.N.jog-counts => axis.c.jog-counts
