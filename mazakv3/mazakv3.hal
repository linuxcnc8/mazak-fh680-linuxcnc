net a-pos-fb               <=  hm2_7i92.0.encoder.03.position
net a-vel-fb               <=  hm2_7i92.0.encoder.03.velocity
net a-pos-fb               =>  joint.3.motor-pos-fb
net a-index-enable    		joint.3.index-enable  <=>  hm2_7i92.0.encoder.03.index-enable
net a-pos-rawcounts        <=  hm2_7i92.0.encoder.03.rawcounts

# ---setup home / limit switch signals---

net a-axis-home     =>  joint.3.home-sw-in
net a-both-limit     =>  joint.3.neg-lim-sw-in
net a-both-limit    =>  joint.3.pos-lim-sw-in

#*******************
