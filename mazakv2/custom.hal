# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again


# **** Setup for external estop ladder program -START ****

net estop-out     => classicladder.0.in-00
net estop-ext     => classicladder.0.in-01
net estop-strobe     classicladder.0.in-02   <=  iocontrol.0.user-request-enable
net estop-outcl      classicladder.0.out-00  =>  iocontrol.0.emc-enable-in

# **** Setup for external estop ladder program -END ****

# --- ESTOP-EXT ---
# Moved off the 7i70 (was input-47) onto the 7i97's own isolated input 0 on
# TB4 pin 1, so estop no longer depends on the sserial chain being alive.
# Note IN0/IN1 are also QUADA-0/QUADB-0 of the 7i97's MPG encoder inputs, so
# MPG encoder 0 must be left unused - the handwheel is on a different pair.
net estop-ext hm2_7i97.0.gpio.000.in

# hydraulic pump - was 7i77 output-00, now a 7i76 field output
net machine-is-on hm2_7i97.0.7i76.0.1.output-00

net lube-on classicladder.0.out-01 hm2_7i97.0.7i71.0.2.output-06
